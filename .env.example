# Copy to .env and adjust. The real .env is gitignored.

# --- PostgreSQL + pgvector (memory + append-only audit log) -----------------
POSTGRES_USER=energymind
POSTGRES_PASSWORD=energymind
POSTGRES_DB=energymind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PG_DSN=postgresql://energymind:energymind@localhost:5432/energymind

# --- Local LLM agents (default backend: ollama) -----------------------------
OLLAMA_HOST=http://localhost:11434

# --- OpenAI-compatible backend (vLLM/SGLang locally, or a cloud provider) ---
# Only used when configs/agents.yaml sets backend: openai_compatible.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
